# Copy to .env and fill in. .env is gitignored.
#
# Two namespaces, per docs/11:
#   SB__SECTION__KEY  overrides any key in config/switchboard.toml
#   bare names        secrets, and the names the ecosystem already demands
#                     (sqlx reads DATABASE_URL; every OpenAI example sets OPENAI_API_KEY)

# Server
SB__SERVER__PORT=8080
# Peers whose x-forwarded-for may be believed. Empty (the default) means the socket
# address is used, so nobody can forge their way past the per-IP limiter.
# SB__SERVER__TRUSTED_PROXIES=["10.0.0.1"]
# Time is milliseconds, everywhere.
# SB__SERVER__REQUEST_TIMEOUT_MS=300000
# Phase 4 agent loop (server-side tool execution)
# SB__AGENT__ENABLED=true
RUST_LOG=switchboard=debug,tower_http=debug,info

# Host ports for the docker-compose stack. Override when something else already
# holds the default, and keep the URLs below in sync.
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://switchboard:switchboard@localhost:5432/switchboard

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Read-only pool for sql_query tool (optional; derived from DATABASE_URL if unset)
# TOOL_RO_DATABASE_URL=postgres://switchboard_tool_ro:switchboard_ro@localhost:5432/switchboard

# Ollama.
#
# `OLLAMA_BASE_URL` is read by run_local_test.sh, not by the gateway. The gateway takes
# its base URL from config/switchboard.toml, overridable only through the SB__ namespace
# documented at the top of this file. Setting a bare `OLLAMA_BASE_URL` and expecting the
# gateway to honour it is a mistake this comment exists to prevent.
#
# SB__PROVIDERS__OLLAMA__BASE_URL=http://localhost:11434
#
# auto: GPU → host install; no GPU → docker CPU (Ubuntu/macOS)
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODE=auto      # auto (default) | host | docker
# OLLAMA_INSTALL=0      # skip auto-install on host/GPU path
# OLLAMA_GPU=1          # force treat as GPU host path
# OLLAMA_GPU=0          # force docker CPU path

# Budget alerts. Your endpoint, never a tenant's — see config/switchboard.toml [billing].
# SB__BILLING__BUDGET_WEBHOOK_URL=https://ops.example.com/hooks/switchboard-budget

# OpenAI — only needed to verify wire compatibility and to run eval comparisons.
#
# The key is a bare name because the whole ecosystem demands that spelling. The base URL
# is not: it lives in config/switchboard.toml, and the override below is the only one the
# gateway reads. A bare `OPENAI_BASE_URL` is ignored — which, if you point it at a local
# stub and it silently reaches api.openai.com instead, you will discover as a `401`.
OPENAI_API_KEY=
# SB__PROVIDERS__OPENAI__BASE_URL=http://localhost:18100/v1

# Anthropic — the third provider. Not wired up before Phase 2.
ANTHROPIC_API_KEY=
